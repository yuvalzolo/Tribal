            <!-- Application Visibility - Make custom applications available -->
            
            <applicationVisibilities>
                <application>Chess_Game_Manager</application>
                <visible>true</visible>
            </applicationVisibilities>
            
            
            <!-- Apex Class Access - Grant access to Apex classes -->
            
            <classAccesses>
                <apexClass>CHE_ChessGameTriggerHandler</apexClass>
                <enabled>true</enabled>
            </classAccesses>
            
            <classAccesses>
                <apexClass>CHE_ChessGameViewerController</apexClass>
