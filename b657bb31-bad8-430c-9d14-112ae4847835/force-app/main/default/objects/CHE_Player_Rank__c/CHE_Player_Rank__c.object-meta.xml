<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
            <deploymentStatus>Deployed</deploymentStatus>
            <description>Historical ranking snapshots showing player rank position, ELO rating at that time, games played, and win rate for tracking player progression over time</description>
            <enableActivities>true</enableActivities>
            <enableBulkApi>true</enableBulkApi>
            <enableFeeds>true</enableFeeds>
            <enableHistory>true</enableHistory>
            <enableReports>true</enableReports>
            <enableSearch>true</enableSearch>
            <enableSharing>true</enableSharing>
            <enableStreamingApi>true</enableStreamingApi>
            <externalSharingModel>Private</externalSharingModel>
            <label>Player Rank</label>
            <nameField>
                <displayFormat>RNK--{00000}</displayFormat>
                <label>Rank Number</label>
                <type>AutoNumber</type>
            </nameField>
            <pluralLabel>Player Rankings</pluralLabel>
            <searchLayouts>
                <searchFilterFields>NAME</searchFilterFields>
                <searchResultsAdditionalFields>CREATED_DATE</searchResultsAdditionalFields>
            </searchLayouts>
            <sharingModel>ReadWrite</sharingModel>
            <visibility>Public</visibility>
        </CustomObject>