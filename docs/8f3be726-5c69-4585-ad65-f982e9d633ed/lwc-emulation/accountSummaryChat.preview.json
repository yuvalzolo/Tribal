{"preview_html":"<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@salesforce-ux/design-system@2.22.3/assets/styles/salesforce-lightning-design-system.min.css\">\n\n<div class=\"account-summary-container\">\n    <!-- Account Header Card -->\n    <div class=\"slds-box slds-theme_default header-card\">\n        <div class=\"slds-text-heading_medium slds-m-bottom_small\">Acme Corporation</div>\n        <div class=\"slds-grid slds-gutters_small slds-wrap\">\n            <div class=\"slds-col slds-size_1-of-2\">\n                <div class=\"slds-text-body_small slds-text-color_weak\">Industry</div>\n                <div class=\"slds-text-body_regular\">Technology</div>\n            </div>\n            <div class=\"slds-col slds-size_1-of-2\">\n                <div class=\"slds-text-body_small slds-text-color_weak\">Type</div>\n                <div class=\"slds-text-body_regular\">Customer - Direct</div>\n            </div>\n            <div class=\"slds-col slds-size_1-of-1\">\n                <div class=\"slds-text-body_small slds-text-color_weak\">Account Owner</div>\n                <div class=\"slds-text-body_regular\">Sarah Johnson</div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Key Metrics Cards -->\n    <div class=\"slds-grid slds-gutters_small slds-wrap metrics-section\">\n        <div class=\"slds-col slds-size_1-of-2 slds-medium-size_1-of-4\">\n            <div class=\"slds-box metric-card\">\n                <div class=\"metric-value\">8</div>\n                <div class=\"metric-label\">Opportunities</div>\n            </div>\n        </div>\n        <div class=\"slds-col slds-size_1-of-2 slds-medium-size_1-of-4\">\n            <div class=\"slds-box metric-card\">\n                <div class=\"metric-value\">$450,000</div>\n                <div class=\"metric-label\">Pipeline Value</div>\n            </div>\n        </div>\n        <div class=\"slds-col slds-size_1-of-2 slds-medium-size_1-of-4\">\n            <div class=\"slds-box metric-card\">\n                <div class=\"metric-value\">3</div>\n                <div class=\"metric-label\">Open Cases</div>\n            </div>\n        </div>\n        <div class=\"slds-col slds-size_1-of-2 slds-medium-size_1-of-4\">\n            <div class=\"slds-box metric-card\">\n                <div class=\"metric-value\">12</div>\n                <div class=\"metric-label\">Contacts</div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Opportunities Section -->\n    <div class=\"slds-box section-card\">\n        <div class=\"slds-text-heading_small slds-m-bottom_small\">Recent Opportunities</div>\n        <div class=\"record-item\">\n            <div class=\"slds-grid\">\n                <div class=\"slds-col slds-size_7-of-12\">\n                    <div class=\"record-name\">Enterprise Platform Upgrade</div>\n                    <div class=\"record-detail\">Stage: Proposal/Price Quote</div>\n                </div>\n                <div class=\"slds-col slds-size_5-of-12 slds-text-align_right\">\n                    <div class=\"record-amount\">$250,000</div>\n                    <div class=\"record-detail\">Close: Dec 31, 2024</div>\n                </div>\n            </div>\n        </div>\n        <div class=\"record-item\">\n            <div class=\"slds-grid\">\n                <div class=\"slds-col slds-size_7-of-12\">\n                    <div class=\"record-name\">Cloud Migration Services</div>\n                    <div class=\"record-detail\">Stage: Negotiation/Review</div>\n                </div>\n                <div class=\"slds-col slds-size_5-of-12 slds-text-align_right\">\n                    <div class=\"record-amount\">$150,000</div>\n                    <div class=\"record-detail\">Close: Jan 15, 2025</div>\n                </div>\n            </div>\n        </div>\n        <div class=\"record-item\">\n            <div class=\"slds-grid\">\n                <div class=\"slds-col slds-size_7-of-12\">\n                    <div class=\"record-name\">Support Contract Renewal</div>\n                    <div class=\"record-detail\">Stage: Closed Won</div>\n                </div>\n                <div class=\"slds-col slds-size_5-of-12 slds-text-align_right\">\n                    <div class=\"record-amount\">$50,000</div>\n                    <div class=\"record-detail\">Close: Nov 20, 2024</div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Cases Section -->\n    <div class=\"slds-box section-card\">\n        <div class=\"slds-text-heading_small slds-m-bottom_small\">Recent Cases</div>\n        <div class=\"record-item\">\n            <div class=\"slds-grid\">\n                <div class=\"slds-col slds-size_8-of-12\">\n                    <div class=\"record-name\">System Performance Issues</div>\n                    <div class=\"record-detail\">Case #00001234</div>\n                </div>\n                <div class=\"slds-col slds-size_4-of-12 slds-text-align_right\">\n                    <div class=\"case-status\">In Progress</div>\n                    <div class=\"record-detail\">Priority: High</div>\n                </div>\n            </div>\n        </div>\n        <div class=\"record-item\">\n            <div class=\"slds-grid\">\n                <div class=\"slds-col slds-size_8-of-12\">\n                    <div class=\"record-name\">Feature Request - Dashboard</div>\n                    <div class=\"record-detail\">Case #00001235</div>\n                </div>\n                <div class=\"slds-col slds-size_4-of-12 slds-text-align_right\">\n                    <div class=\"case-status\">New</div>\n                    <div class=\"record-detail\">Priority: Medium</div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Contacts Section -->\n    <div class=\"slds-box section-card\">\n        <div class=\"slds-text-heading_small slds-m-bottom_small\">Primary Contacts</div>\n        <div class=\"record-item\">\n            <div class=\"record-name\">John Smith</div>\n            <div class=\"record-detail\">VP of Technology</div>\n            <div class=\"record-detail\">john.smith@acme.com</div>\n            <div class=\"record-detail\">(555) 123-4567</div>\n        </div>\n        <div class=\"record-item\">\n            <div class=\"record-name\">Emily Davis</div>\n            <div class=\"record-detail\">Director of Operations</div>\n            <div class=\"record-detail\">emily.davis@acme.com</div>\n            <div class=\"record-detail\">(555) 234-5678</div>\n        </div>\n        <div class=\"record-item\">\n            <div class=\"record-name\">Michael Chen</div>\n            <div class=\"record-detail\">IT Manager</div>\n            <div class=\"record-detail\">michael.chen@acme.com</div>\n            <div class=\"record-detail\">(555) 345-6789</div>\n        </div>\n    </div>\n\n    <!-- Activities Section -->\n    <div class=\"slds-box section-card\">\n        <div class=\"slds-text-heading_small slds-m-bottom_small\">Recent Activities</div>\n        <div class=\"record-item\">\n            <div class=\"slds-grid\">\n                <div class=\"slds-col slds-size_8-of-12\">\n                    <div class=\"record-name\">Quarterly Business Review</div>\n                    <div class=\"record-detail\">Type: Meeting</div>\n                </div>\n                <div class=\"slds-col slds-size_4-of-12 slds-text-align_right\">\n                    <div class=\"record-detail\">Completed</div>\n                    <div class=\"record-detail\">Nov 15, 2024</div>\n                </div>\n            </div>\n        </div>\n        <div class=\"record-item\">\n            <div class=\"slds-grid\">\n                <div class=\"slds-col slds-size_8-of-12\">\n                    <div class=\"record-name\">Follow-up on Platform Upgrade</div>\n                    <div class=\"record-detail\">Type: Call</div>\n                </div>\n                <div class=\"slds-col slds-size_4-of-12 slds-text-align_right\">\n                    <div class=\"record-detail\">Completed</div>\n                    <div class=\"record-detail\">Nov 18, 2024</div>\n                </div>\n            </div>\n        </div>\n        <div class=\"record-item\">\n            <div class=\"slds-grid\">\n                <div class=\"slds-col slds-size_8-of-12\">\n                    <div class=\"record-name\">Send Proposal Documentation</div>\n                    <div class=\"record-detail\">Type: Email</div>\n                </div>\n                <div class=\"slds-col slds-size_4-of-12 slds-text-align_right\">\n                    <div class=\"record-detail\">Planned</div>\n                    <div class=\"record-detail\">Nov 25, 2024</div>\n                </div>\n            </div>\n        </div>\n    </div>\n</div>","preview_js":"// Initialize with sample data\n(function() {\n    // No dynamic behavior needed for this preview\n    // All data is rendered statically in the HTML\n    console.log('Account Summary Chat component loaded');\n})();","preview_css":".account-summary-container {\n    padding: 0.5rem;\n    max-width: 100%;\n}\n\n.header-card {\n    margin-bottom: 1rem;\n    padding: 1rem;\n    background-color: var(--slds-g-color-neutral-base-95, #f3f3f3);\n}\n\n.metrics-section {\n    margin-bottom: 1rem;\n}\n\n.metric-card {\n    padding: 1rem;\n    text-align: center;\n    background-color: var(--slds-g-color-brand-base-10, #e8f4f9);\n    border: none;\n}\n\n.metric-value {\n    font-size: 1.5rem;\n    font-weight: 700;\n    color: var(--slds-g-color-brand-base-50, #0176d3);\n    margin-bottom: 0.25rem;\n}\n\n.metric-label {\n    font-size: 0.75rem;\n    color: var(--slds-g-color-neutral-base-50, #706e6b);\n    text-transform: uppercase;\n    letter-spacing: 0.025rem;\n}\n\n.section-card {\n    margin-bottom: 1rem;\n    padding: 1rem;\n}\n\n.record-item {\n    padding: 0.75rem;\n    border-bottom: 1px solid var(--slds-g-color-border-base-1, #c9c9c9);\n}\n\n.record-item:last-child {\n    border-bottom: none;\n}\n\n.record-name {\n    font-weight: 600;\n    font-size: 0.875rem;\n    margin-bottom: 0.25rem;\n    color: var(--slds-g-color-neutral-base-10, #181818);\n}\n\n.record-detail {\n    font-size: 0.75rem;\n    color: var(--slds-g-color-neutral-base-50, #706e6b);\n    margin-top: 0.125rem;\n}\n\n.record-amount {\n    font-weight: 600;\n    font-size: 0.875rem;\n    color: var(--slds-g-color-success-base-50, #2e844a);\n}\n\n.case-status {\n    font-weight: 600;\n    font-size: 0.875rem;\n    color: var(--slds-g-color-neutral-base-10, #181818);\n}\n\n/* Responsive adjustments */\n@media (max-width: 768px) {\n    .metric-value {\n        font-size: 1.25rem;\n    }\n\n    .metric-label {\n        font-size: 0.625rem;\n    }\n}"}